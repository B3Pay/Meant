        "name": "memory:/unplaceable.did",
        "source": "// Tags no v0 address reaches, and tags in the wrong place: each is an error.\n\ntype Hook = func (record {\n  /// @amount(decimals = 8)\n  x : nat;\n}) -> ();\ntype Callback = service {\n  /// @effect(kind = \"write\", irreversible = false)\n  notify : (nat) -> ();\n};\ntype Pair = record {\n  /// @intent(title = \"No\", template = \"No\")\n  a : nat;\n  b : nat;\n};\n/// @amount(decimals = 8)\nservice : {\n  decimals : () -> (nat8) query;\n  /// @amount(decimals = 8)\n  bare : (nat) -> ();\n  /// @effect(at = \"x\", kind = \"read\", irreversible = false)\n  misplaced : (record { x : nat }) -> ();\n  /// @amount(at = \"x\", decimals = 8)\n  two : (record { x : nat }, nat) -> ();\n  /// @amount(at = \"(0)\", decimals = 0.5)\n  fraction : (nat) -> ();\n  /// @amount(at = \"(0)\", decimals = query(decimals, symbol))\n  badcall : (nat) -> ();\n  /// @amount(at = \"(0)\", decimals = later())\n  unknowncall : (nat) -> ();\n  /// @amount(at = \"(0\", decimals = 8)\n  badat : (nat) -> ();\n  /// @amount(at = x, decimals = 8)\n  identat : (nat) -> ();\n  hook : (Hook) -> ();\n  subscribe : (Callback) -> ();\n  pair : (Pair) -> ();\n  /// @effect(kind = \"write\", irreversible = false)\n  \"quoted-name\" : () -> ();\n  watch : (service {\n    /// @effect(kind = \"write\", irreversible = false)\n    notify : (record {\n      /// @amount(decimals = 8)\n      v : nat;\n    }) -> ();\n  }) -> ();\n  inline : (record {\n    /// @amount(at = \"(0)\", decimals = 8)\n    y : nat;\n  }, func (record {\n    /// @amount(decimals = 8)\n    z : nat;\n  }) -> ()) -> ();\n}\n"
