    "sources": [
      {
        "name": "memory:/places.did",
        "source": "// Every place a doc comment can put a tag (spec section 9, OQ-4).\n\ntype Account = record { owner : principal; subaccount : opt blob };\n/// An account and an amount.\ntype Payment = record {\n  /// @account\n  /// @bytes(at = \"subaccount\", encoding = \"hex\")\n  to : Account;\n  /// How much, in e8s.\n  /// @amount(decimals = 8, symbol = \"ICP\")\n  amount : nat;\n  /// The number of retries.\n  retries : nat8;\n  /// @describe(label = \"Count\")\n  /// How many times.\n  count : nat;\n  /// @timestamp(unit = ns)\n  /// @default(value = now(), mode = auto)\n  created_at : opt nat64;\n};\n/// A token amount.\ntype Tokens = nat;\ntype Status = variant {\n  /// @describe(label = \"Done\")\n  Done;\n  /// Still running.\n  Running : record { progress : nat8 };\n};\nservice : {\n  decimals : () -> (nat8) query;\n  /// Pay someone.\n  ///\n  /// The payment is final.\n  /// @intent(title = \"Pay\", template = \"Pay {amount} to {to}\")\n  /// @effect(kind = \"transfer\", irreversible = true)\n  /// @outcome(classes = { Ok = success, \"Err.TooOld\" = fix_input }, default = fail)\n  pay : (Payment) -> (variant { Ok : nat; Err : variant { TooOld; Other : text } });\n  /// @amount(at = \"(0)\", decimals = query(decimals))\n  /// @timestamp(at = \"(1)\", unit = ns)\n  /// @range(at = \"(2)\", min = 1, max = 18446744073709551615)\n  multi : (nat, nat64, nat) -> ();\n  inline : (record {\n    /// Who receives it.\n    who : principal;\n    items : opt vec record {\n      /// @amount(decimals = 2)\n      price : nat;\n    };\n    /// @describe(label = \"Mode\")\n    mode : variant { Fast; Slow };\n  }) -> (variant {\n    /// @timestamp(unit = ms)\n    Ok : nat64;\n    Err : text;\n  });\n  status : () -> (Status) query;\n  /// @ui.hidden()\n  /// @deprecated\n  /// @amout(decimals = 8)\n  old : (nat) -> ();\n}\n"
      }
    ]
  }
