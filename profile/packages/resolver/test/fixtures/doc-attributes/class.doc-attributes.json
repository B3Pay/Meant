        "name": "memory:/class.did",
        "source": "// A service class whose methods come from a declared service type.\n\ntype Api = service {\n  /// Read the counter.\n  /// @effect(kind = \"read\", irreversible = false)\n  get : () -> (nat) query;\n  /// @intent(title = \"Add\", template = \"Add {n}\")\n  add : (record {\n    /// @describe(label = \"How much\")\n    n : nat;\n  }) -> ();\n};\nservice : (nat) -> Api\n"
