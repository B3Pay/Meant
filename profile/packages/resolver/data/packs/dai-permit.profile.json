{
  "format": "candid-profile",
  "format_version": 0,
  "kind": "contract",
  "name": "dai-permit",
  "origin": "third_party",
  "language": "en",
  "description": "DAI's permit on Ethereum mainnet (spec section 15.9, experimental), older than EIP-2612 and different from it: `allowed` sets the allowance to all of the holder's DAI (true, uint256 max) or to none (false), and `expiry` 0 means the signature never expires (MakerDAO dss, src/dai.sol). Only the message is described; DAI's functions are ERC-20's and the erc20 pack covers them.",
  "binds": {
    "eip712": {
      "domain": {
        "name": "Dai Stablecoin",
        "version": "1"
      },
      "types": {
        "Permit": [
          {
            "name": "holder",
            "type": "address"
          },
          {
            "name": "spender",
            "type": "address"
          },
          {
            "name": "nonce",
            "type": "uint256"
          },
          {
            "name": "expiry",
            "type": "uint256"
          },
          {
            "name": "allowed",
            "type": "bool"
          }
        ]
      }
    },
    "deployments": [
      {
        "chain_id": 1,
        "address": "0x6B175474E89094C44Da98b954EedeAC495271d0F"
      }
    ]
  },
  "annotations": [
    {
      "at": "Permit",
      "tag": "intent",
      "args": {
        "title": "Permit DAI spending",
        "template": "Set the DAI allowance {holder} gives {spender} to all of it if allowed is true, to none if false (allowed: {allowed}). Signature expires: {expiry}."
      }
    },
    {
      "at": "Permit",
      "tag": "effect",
      "args": {
        "kind": "approve",
        "irreversible": false,
        "grant": {
          "spender": "spender",
          "amount": "allowed"
        }
      }
    },
    {
      "at": "Permit(0).holder",
      "tag": "describe",
      "args": {
        "label": "Holder"
      }
    },
    {
      "at": "Permit(0).spender",
      "tag": "describe",
      "args": {
        "label": "Spender"
      }
    },
    {
      "at": "Permit(0).allowed",
      "tag": "describe",
      "args": {
        "label": "Allowed (true: all, false: none)"
      }
    },
    {
      "at": "Permit(0).expiry",
      "tag": "timestamp",
      "args": {
        "unit": "s",
        "epoch": "unix",
        "threshold": "115792089237316195423570985008687907853269984665640564039457584007913129639935",
        "message": "Never",
        "labels": {
          "0": "Never"
        }
      }
    },
    {
      "at": "Permit(0).expiry",
      "tag": "describe",
      "args": {
        "label": "Signature expires"
      }
    },
    {
      "at": "Permit(0).nonce",
      "tag": "describe",
      "args": {
        "label": "Nonce"
      }
    }
  ]
}
