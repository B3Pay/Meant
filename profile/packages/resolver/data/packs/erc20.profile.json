{
  "format": "candid-profile",
  "format_version": 0,
  "kind": "pack",
  "name": "erc20",
  "origin": "pack",
  "language": "en",
  "description": "Standard pack for EIP-20 tokens on EVM chains (spec section 15, experimental). Applies to any contract that has every function of `binds.abi` with the same selector, outputs and kind of call; parameter names may differ (they are matched by position). `name()` is left out: no annotation reads it and EIP-20 makes it optional. A token without `decimals()` or `symbol()` matches no pack and needs a contract profile with literal values.",
  "binds": {
    "standard": "ERC-20",
    "spec_url": "https://eips.ethereum.org/EIPS/eip-20",
    "abi": [
      "function symbol() view returns (string)",
      "function decimals() view returns (uint8)",
      "function balanceOf(address owner) view returns (uint256)",
      "function allowance(address owner, address spender) view returns (uint256)",
      "function transfer(address to, uint256 value) returns (bool)",
      "function approve(address spender, uint256 value) returns (bool)",
      "function transferFrom(address from, address to, uint256 value) returns (bool)"
    ]
  },
  "annotations": [
    {
      "at": "transfer",
      "tag": "intent",
      "args": {
        "title": "Send tokens",
        "template": "Send {value} to {to}"
      }
    },
    {
      "at": "transfer",
      "tag": "effect",
      "args": {
        "kind": "transfer",
        "irreversible": true
      }
    },
    {
      "at": "transfer(0).value",
      "tag": "amount",
      "args": {
        "decimals": {
          "from": "query:decimals"
        },
        "symbol": {
          "from": "query:symbol"
        }
      }
    },
    {
      "at": "transfer(0).value",
      "tag": "describe",
      "args": {
        "label": "Amount"
      }
    },
    {
      "at": "transfer(0).to",
      "tag": "describe",
      "args": {
        "label": "Recipient"
      }
    },
    {
      "at": "approve",
      "tag": "intent",
      "args": {
        "title": "Approve spending",
        "template": "Set {spender}'s allowance to {value}, replacing any existing allowance"
      }
    },
    {
      "at": "approve",
      "tag": "effect",
      "args": {
        "kind": "approve",
        "irreversible": false
      }
    },
    {
      "at": "approve(0).spender",
      "tag": "describe",
      "args": {
        "label": "Spender"
      }
    },
    {
      "at": "approve(0).value",
      "tag": "amount",
      "args": {
        "decimals": {
          "from": "query:decimals"
        },
        "symbol": {
          "from": "query:symbol"
        },
        "threshold": "115792089237316195423570985008687907853269984665640564039457584007913129639935",
        "message": "Unlimited"
      }
    },
    {
      "at": "approve(0).value",
      "tag": "describe",
      "args": {
        "label": "Allowance",
        "help": "Maximum the spender may transfer. An approval replaces the previous allowance; it does not add to it."
      }
    },
    {
      "at": "transferFrom",
      "tag": "intent",
      "args": {
        "title": "Transfer using allowance",
        "template": "Move {value} from {from} to {to} using an allowance"
      }
    },
    {
      "at": "transferFrom",
      "tag": "effect",
      "args": {
        "kind": "transfer",
        "irreversible": true
      }
    },
    {
      "at": "transferFrom(0).from",
      "tag": "describe",
      "args": {
        "label": "From"
      }
    },
    {
      "at": "transferFrom(0).to",
      "tag": "describe",
      "args": {
        "label": "Recipient"
      }
    },
    {
      "at": "transferFrom(0).value",
      "tag": "amount",
      "args": {
        "decimals": {
          "from": "query:decimals"
        },
        "symbol": {
          "from": "query:symbol"
        }
      }
    },
    {
      "at": "transferFrom(0).value",
      "tag": "describe",
      "args": {
        "label": "Amount"
      }
    },
    {
      "at": "balanceOf",
      "tag": "describe",
      "args": {
        "label": "Balance of an address"
      }
    },
    {
      "at": "balanceOf(0).owner",
      "tag": "describe",
      "args": {
        "label": "Owner"
      }
    },
    {
      "at": "balanceOf->(0)",
      "tag": "amount",
      "args": {
        "decimals": {
          "from": "query:decimals"
        },
        "symbol": {
          "from": "query:symbol"
        }
      }
    },
    {
      "at": "allowance",
      "tag": "describe",
      "args": {
        "label": "Allowance of a spender"
      }
    },
    {
      "at": "allowance(0).owner",
      "tag": "describe",
      "args": {
        "label": "Owner"
      }
    },
    {
      "at": "allowance(0).spender",
      "tag": "describe",
      "args": {
        "label": "Spender"
      }
    },
    {
      "at": "allowance->(0)",
      "tag": "amount",
      "args": {
        "decimals": {
          "from": "query:decimals"
        },
        "symbol": {
          "from": "query:symbol"
        },
        "threshold": "115792089237316195423570985008687907853269984665640564039457584007913129639935",
        "message": "Unlimited"
      }
    }
  ]
}
