    "eip712": {
      "domain": {
        "name": "USDC",
        "version": "2"
      },
      "types": {
        "CancelAuthorization": [
          {
            "name": "authorizer",
            "type": "address"
          },
          {
            "name": "nonce",
            "type": "bytes32"
          }
        ],
        "ReceiveWithAuthorization": [
          {
            "name": "from",
            "type": "address"
          },
          {
            "name": "to",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          },
          {
            "name": "validAfter",
            "type": "uint256"
          },
          {
            "name": "validBefore",
            "type": "uint256"
          },
          {
            "name": "nonce",
            "type": "bytes32"
          }
        ],
        "TransferWithAuthorization": [
          {
            "name": "from",
            "type": "address"
          },
          {
            "name": "to",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          },
          {
            "name": "validAfter",
            "type": "uint256"
