    "sources": [
      {
        "name": "memory:/service.did",
        "source": "// Doc attributes v1 (docs/doc-attributes.md): the input of the\n// attributes.doc-attributes.json golden, which tests/doc_attributes.rs and\n// npm/test/doc-attributes.test.js both compare against.\n\n/// Token amounts.\n/// @ui.group(name = \"Ledger\")\ntype Tokens = record {\n  /// @amount(decimals = 8, symbol = \"ICP\")\n  e8s : nat64;\n};\n\ntype Outcome = variant {\n  /// @class(kind = success)\n  Ok : nat;\n  /// @param code prose, not an attribute\n  Err : record { code : nat32; message : text };\n};\n\n/// A ledger.\n/// @deprecated\nservice : {\n  decimals : () -> (nat8) query;\n  /// Send tokens to another principal.\n  /// @intent(\n  ///   title = \"Send\",\n  ///   template = \"Send {amount} to {to}[ with memo {memo}]\",\n  /// )\n  /// @effect(kind = \"transfer\", irreversible = true)\n  /// @amount(at = \"amount\", decimals = query(decimals), symbol = \"TOK\")\n  /// @bytes(at = \"memo\", encoding = \"utf8\", max_len = 32)\n  /// @outcome(classes = { Ok = \"success\", \"Err.code\" = \"fail\" }, default = \"fail\")\n  send : (record { to : principal; amount : nat; memo : opt blob }) -> (Outcome);\n  /// @ranges(values = [-1, 0, 0.25, \"\\u{1F600}\"], flags = [true, false], nothing = [])\n  tune : (record {\n    /// @describe(label = \"Who\")\n    who : principal;\n  }) -> ();\n}\n"
      }
    ]
